{
  "name": "todaystrain",
  "version": "0.1.0",
  "private": true,
  "description": "TodaysTrain.com — বাংলাদেশের ট্রেনের সময়সূচী, বন্ধের দিন ও রুট তথ্য (স্ট্যাটিক সাইট)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "data:parse": "python3 scripts/parse_pdfs.py",
    "data:validate": "tsx scripts/validate-data.ts",
    "prebuild": "npm run data:validate && tsx scripts/build-search-index.ts",
    "build": "next build",
    "postbuild": "tsx scripts/check-export.ts",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
