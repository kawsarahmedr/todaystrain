# Public build-time variables (safe to expose). Copy to .env.local for local builds.
# Turnstile SITE key (public). Cloudflare's test key that always passes:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Keep "false" until AdSense is approved and the ad code is added.
NEXT_PUBLIC_ADS_ENABLED=false
